---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer" id="contact">
  <div class="container">
    <span class="section-label">Contact</span>

    <p class="footer-lede">
      Open to research collaborations and graduate opportunities in device engineering and
      compute-in-memory. The fastest way to reach me is email —
      <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>

    <p class="footer-links">
      <a href={site.cv}>CV</a>
      <span aria-hidden="true">·</span>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <span aria-hidden="true">·</span>
      <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <span aria-hidden="true">·</span>
      <a href={`mailto:${site.emailAlt}`}>Institutional email</a>
    </p>

    <p class="footer-copy">&copy; {year} {site.name} · {site.location}</p>
  </div>
</footer>

<style>
  .footer {
    padding: 4rem 0 3rem;
  }

  .footer-lede {
    font-family: var(--font-display);
    font-size: var(--text-heading);
    font-weight: 400;
    line-height: var(--leading-snug);
    max-width: 34ch;
    margin-bottom: 1.5rem;
  }

  .footer-links {
    font-size: var(--text-small);
    color: var(--color-text-tertiary);
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .footer-copy {
    font-size: var(--text-micro);
    color: var(--color-text-tertiary);
  }
</style>
