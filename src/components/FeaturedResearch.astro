---
import { Image } from 'astro:assets';
import { research } from '../data/research';
---

<section class="research" id="research">
  <div class="container container-wide">
    <span class="section-label">Featured Research</span>

    <div class="research-list">
      {research.map((entry, i) => (
        <article class="research-item">
          <div class="research-head">
            <span class="research-index">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="research-title">{entry.title}</h3>
              <p class="research-meta">
                {entry.affiliation} · {entry.date}
                {entry.collaborators ? <span class="research-collab"> · {entry.collaborators}</span> : null}
              </p>
            </div>
          </div>

          <p class="research-summary">{entry.summary}</p>

          <figure class="research-figure">
            <Image
              src={entry.image}
              alt={entry.imageAlt}
              widths={[600, 900, 1200]}
              sizes="(min-width: 1100px) 1040px, 92vw"
              format="webp"
              quality={82}
              loading="lazy"
            />
            <figcaption>{entry.imageCaption}</figcaption>
          </figure>

          <div class="research-detail">
            <h4 class="research-detail-label">Key contributions</h4>
            <ul class="research-contributions">
              {entry.contributions.map((c) => <li>{c}</li>)}
            </ul>
            <p class="research-tags">{entry.tags.join(' · ')}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .container-wide {
    max-width: 1100px;
  }

  .research-list {
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
  }

  .research-item {
    display: flex;
    flex-direction: column;
  }

  .research-head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: baseline;
    margin-bottom: 1.25rem;
  }

  .research-index {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--color-accent);
    font-variant-numeric: oldstyle-nums;
  }

  .research-title {
    font-size: var(--text-heading);
    font-weight: 500;
    line-height: var(--leading-snug);
    letter-spacing: -0.01em;
    margin-bottom: 0.4rem;
    text-wrap: balance;
  }

  .research-meta {
    font-size: var(--text-micro);
    color: var(--color-text-tertiary);
    line-height: var(--leading-snug);
  }

  .research-collab {
    font-style: italic;
  }

  .research-summary {
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 72ch;
    margin-bottom: 2rem;
  }

  .research-figure {
    margin: 0 0 2rem;
  }

  .research-figure :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--color-rule);
    padding: 0.75rem;
    background: var(--color-bg-elevated);
    border-radius: 4px;
  }

  .research-figure figcaption {
    font-size: var(--text-micro);
    color: var(--color-text-tertiary);
    line-height: var(--leading-snug);
    margin-top: 0.85rem;
    max-width: 78ch;
    font-style: italic;
    font-family: var(--font-display);
  }

  .research-detail-label {
    font-size: var(--text-micro);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    font-family: var(--font-body);
    margin-bottom: 1rem;
  }

  .research-contributions {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    max-width: 76ch;
    margin-bottom: 1.5rem;
  }

  .research-contributions li {
    position: relative;
    padding-left: 1.35rem;
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .research-contributions li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .research-tags {
    font-size: var(--text-micro);
    font-style: italic;
    font-family: var(--font-display);
    color: var(--color-text-tertiary);
  }

  @media (min-width: 640px) {
    .research-head {
      gap: 1.4rem;
    }
    .research-index {
      font-size: 1.6rem;
    }
  }
</style>
