---
import { honors } from '../data/honors';
---

<section class="honors" id="honors">
  <div class="container">
    <span class="section-label">Honors, Awards &amp; Fellowships</span>

    <div class="honors-list">
      {honors.map((h) => (
        <article class="honor-row">
          <div class="honor-meta">
            <span class="honor-date">{h.date}</span>
          </div>
          <div class="honor-body">
            <h3 class="honor-title">{h.title}</h3>
            <p class="honor-issuer">{h.issuer}</p>
            <p class="honor-desc">{h.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .honors-list {
    display: flex;
    flex-direction: column;
  }

  .honor-row {
    display: grid;
    gap: 0.5rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--color-border);
  }

  .honor-row:first-child {
    border-top: none;
    padding-top: 0;
  }

  @media (min-width: 640px) {
    .honor-row {
      grid-template-columns: 11rem 1fr;
      gap: 2rem;
    }
  }

  .honor-date {
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-text-primary);
    font-variant-numeric: oldstyle-nums;
  }

  .honor-title {
    font-size: var(--text-subhead);
    font-weight: 500;
    margin-bottom: 0.15rem;
  }

  .honor-issuer {
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-accent);
    margin-bottom: 0.6rem;
  }

  .honor-desc {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 62ch;
  }
</style>
